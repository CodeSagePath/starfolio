---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
import { DATA } from "@/data/resume";

const collections = [...DATA.photoCollections].sort((first, second) => second.date.localeCompare(first.date));
const formatDate = (date: string) => new Intl.DateTimeFormat("en", {
  month: "long", day: "numeric", year: "numeric", timeZone: "UTC",
}).format(new Date(`${date}T00:00:00Z`));
---

<Layout title="Photography" description="Photo collections from places and moments worth noticing.">
  <main class="mx-auto min-h-dvh w-full max-w-5xl">
    <a href="/#photos" class="mb-8 inline-flex items-center gap-2 text-sm text-muted-foreground transition-colors hover:text-foreground">← Back to portfolio</a>
    <header class="mb-8">
      <p class="mb-2 text-sm font-medium text-primary">Outside the workspace</p>
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Photography</h1>
      <p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">Small collections from days spent looking a little closer.</p>
    </header>
    <div class="grid gap-5 sm:grid-cols-2">
      {collections.map((collection) => (
        <a href={`/photography/${collection.slug}/`} class="group overflow-hidden rounded-xl border border-border bg-card transition-colors hover:border-primary/40">
          <img src={collection.coverImage} alt={`${collection.title} photo collection cover`} loading="lazy" decoding="async" class="h-64 w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]" />
          <div class="flex items-start justify-between gap-4 p-5">
            <div>
              <h2 class="font-semibold group-hover:text-primary">{collection.title}</h2>
              <p class="mt-1 text-sm text-muted-foreground">{collection.location} · {formatDate(collection.date)}</p>
            </div>
            <span class="shrink-0 rounded-full bg-muted px-2.5 py-1 text-xs text-muted-foreground">{collection.photos.length} photos</span>
          </div>
        </a>
      ))}
    </div>
  </main>
</Layout>
