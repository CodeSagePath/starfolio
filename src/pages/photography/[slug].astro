---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
import { DATA } from "@/data/resume";
import ImageGallery from "@/components/section/image-gallery";

export function getStaticPaths() {
  return DATA.photoCollections.map((collection) => ({ params: { slug: collection.slug }, props: { collection } }));
}

const { collection } = Astro.props;
const formatDate = new Intl.DateTimeFormat("en", {
  month: "long", day: "numeric", year: "numeric", timeZone: "UTC",
}).format(new Date(`${collection.date}T00:00:00Z`));
---

<Layout title={collection.title} description={`${collection.photos.length} photographs from ${collection.location}.`}>
  <main class="mx-auto min-h-dvh w-full max-w-5xl">
    <a href="/photography/" class="mb-8 inline-flex items-center gap-2 text-sm text-muted-foreground transition-colors hover:text-foreground">← All collections</a>
    <header class="mb-8">
      <p class="mb-2 text-sm font-medium text-primary">{collection.location} · {formatDate}</p>
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">{collection.title}</h1>
      <p class="mt-3 text-muted-foreground">{collection.photos.length} photographs</p>
    </header>
    <ImageGallery images={collection.photos} label={`${collection.title} gallery`} client:load />
  </main>
</Layout>
