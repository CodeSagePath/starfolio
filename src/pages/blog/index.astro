---
import Layout from "@/layouts/Layout.astro";
import BlogList from "@/components/BlogList";
import { getCollection } from "astro:content";
import { paginate } from "@/lib/pagination";
import { CONFIG } from "@/data/config";

const PAGE_SIZE = CONFIG.blog.postsPerPage;

const allPosts = await getCollection("blog");
const sortedPosts = [...allPosts].sort((a, b) => {
  return Date.parse(b.data.publishedAt) - Date.parse(a.data.publishedAt);
});

const { items: paginatedPosts, pagination } = paginate(sortedPosts, {
  page: 1,
  pageSize: PAGE_SIZE,
});

const posts = paginatedPosts.map((post) => ({
  id: post.id,
  title: post.data.title,
  publishedAt: post.data.publishedAt,
}));
---

<Layout
  title="Blog"
  description="Software engineering articles and notes from CodeSagePath."
  canonicalURL={`${CONFIG.site.url}/blog`}
>
  <BlogList
    client:load
    posts={posts}
    allPostsCount={sortedPosts.length}
    pagination={pagination}
    pageSize={PAGE_SIZE}
  />
</Layout>
